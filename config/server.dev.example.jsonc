{
  // 数据目录：相对路径，相对于本配置文件所在目录解析
  "data_dir": "../data",

  // 日志目录：server.log（运行日志）+ ota.log（升级记录）。留空则不写文件
  "log": {
    "dir": "../log"
  },

  "device": {
    // 本地开发没有平台文件，以下三个字段直接生效（真机会被平台文件覆盖）
    "robot_sn": "AS2_000001",
    "product_id": "AS2",
    "hw_revision": "REV_A",
    "firmware_version": "2.4.0",
    // 安全版本号：低于 min_security_version 的固件会被拒绝（防降级）
    "security_version": 0,
    // 解密后固件的最大字节数（开发用小值，测试更快）
    "max_plaintext_bytes": 16777216,
    // 单个 payload 分片（PATCH 请求体）的最大字节数
    "max_chunk_bytes": 100000
  },

  "crypto": {
    // 开发用软件 PEM 私钥，不用安全芯片
    "key_provider": "software",
    // 设备私钥（PEM），相对于配置文件目录
    "device_private_key_file": "device_key.pem",
    // 平台 CA 证书，相对于配置文件目录
    "plat_ca_file": "plat_ca.pem",
    // 清单签名算法：RSA_PKCS1_SHA256 或 RSA_PSS_SHA256，须与云端一致
    "signature_scheme": "RSA_PKCS1_SHA256",
    // 签名的域分隔前缀
    "sign_domain_prefix": "ROBOT_OFFLINE_OTA_MANIFEST_V1",
    // 是否校验签名者证书有效期
    "check_cert_validity": true
  },

  "http": {
    // 只监听本机回环，开发不对外
    "bind": "127.0.0.1",
    "port": 8080,
    // 处理请求的 worker 线程数 = 同时处理的请求数上限
    "threads": 2,
    // 请求体（body）总大小上限，超过返回 413
    "max_body_bytes": 8388608,
    // 连接空闲超时（秒），超过无数据则断开
    "idle_timeout_seconds": 30,
    // 已建立但还没轮到 worker 处理的连接排队上限，满了拒绝新连接
    "max_queued_connections": 16,
    // HTTP 请求头大小上限，超过返回 431
    "max_header_bytes": 65536
  },

  "session": {
    // 「接收中」会话的存活时长（小时）。超过没收完则标记过期；0 表示不过期
    "receiving_ttl_hours": 24
  },

  "install": {
    // 安装引擎。当前构建只支持 "disabled"（只收包验证，不真正安装）
    "engine": "disabled"
  }
}
